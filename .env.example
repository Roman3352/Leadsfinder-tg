DATABASE_URL="postgresql://leadfinder:leadfinder@localhost:5432/leadfinder?schema=public"

# ============ TELEGRAM ============
TELEGRAM_BOT_TOKEN=""
# Ваш числовой Telegram ID. Бот отвечает только этому ID (узнать его можно, один раз
# запустив бота без этой настройки — он пришлёт вам ваш ID в первом же сообщении).
# Несколько ID — через запятую.
ALLOWED_TELEGRAM_IDS=""

# ============ GOOGLE PLACES ============
GOOGLE_PLACES_API_KEY=""
# Search — только для дедупликации/списка, никаких дорогих полей.
GOOGLE_PLACES_SEARCH_FIELD_MASK="places.id,places.displayName,places.formattedAddress"
# Details — запрашивается только для отобранных компаний.
GOOGLE_PLACES_DETAILS_FIELD_MASK="website,internationalPhoneNumber,rating,userRatingCount,regularOpeningHours,googleMapsUri"
GOOGLE_PLACES_DETAILS_TTL_DAYS=30

# ============ FIRECRAWL (опционально — без ключа deep analysis просто пропускается) ============
FIRECRAWL_API_KEY=""
FIRECRAWL_MAX_PAGES=4
DEEP_ANALYSIS_TTL_DAYS=30

# ============ PAGESPEED (опционально) ============
PAGESPEED_API_KEY=""
PAGESPEED_TTL_DAYS=30

# ============ AI / LLM (опционально — без ключа sales brief/сообщения недоступны) ============
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
DEFAULT_LLM_MODEL="gpt-4o-mini"
LLM_MAX_OUTPUT_TOKENS=700

# ============ ЛИМИТЫ НА ОДИН ПОИСК ============
MAX_GOOGLE_REQUESTS_PER_JOB=250
MAX_FIRECRAWL_CREDITS_PER_JOB=400
MAX_PAGESPEED_REQUESTS_PER_JOB=100
MAX_AI_CALLS_PER_JOB=120

# ============ МЕСЯЧНЫЙ БЮДЖЕТ (EUR, оценка) ============
MAX_MONTHLY_API_BUDGET=20.00
EUR_PER_USD=0.9

# Пороговые значения Lead Score
HOT_LEAD_SCORE=70
AI_MIN_SCORE=40
AI_CONCURRENCY=3
QUICK_CHECK_CONCURRENCY=5

# Примерные ставки провайдеров для оценки стоимости (USD). Это ПРИБЛИЗИТЕЛЬНЫЕ значения —
# сверьте с актуальными прайсами и поправьте. Google зависит от SKU/полей (см. Details FieldMask выше):
# запрос rating/reviews поднимает тариф до Enterprise.
GOOGLE_TEXT_SEARCH_USD_PER_1000_MIN=0
GOOGLE_TEXT_SEARCH_USD_PER_1000_MAX=35
GOOGLE_DETAILS_USD_PER_1000_MIN=0
GOOGLE_DETAILS_USD_PER_1000_MAX=20
FIRECRAWL_USD_PER_CREDIT_MIN=0.0008
FIRECRAWL_USD_PER_CREDIT_MAX=0.003
OPENAI_INPUT_USD_PER_1M=0.15
OPENAI_OUTPUT_USD_PER_1M=0.6
